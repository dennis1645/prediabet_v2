# =========================================================
# PREDIABEAT BACKEND CONFIGURATION
# =========================================================

# Server Port
PORT=5000
NODE_ENV=development

# JWT Authentication Secret & Token Expiry
JWT_SECRET=super_secret_jwt_key_for_prediabeat_clinical_auth_2026_change_in_production
JWT_EXPIRES_IN=7d

# Database Configuration (SQLite)
# To migrate to MySQL later: change provider or connection string
DATABASE_FILE=./data/prediabeat.db

# Client / Frontend Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# External AI Service URL (For RAG / Chatbot Service)
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=prediabeat_ai_internal_token_2026
