# ==============================================================================
# PrediaBeat: Combined Frontend & Backend Production Image
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build React Frontend
# ------------------------------------------------------------------------------
FROM node:22-alpine AS frontend-builder
WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# ------------------------------------------------------------------------------
# Stage 2: Express Backend Server
# ------------------------------------------------------------------------------
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=5000

# Install production dependencies for Express backend
WORKDIR /app/backend
COPY backend/package*.json ./
RUN npm ci --omit=dev

# Copy backend application files & reference datasets
COPY backend/ ./

# Copy built frontend assets to backend public directory
COPY --from=frontend-builder /app/frontend/dist ./public

# Create data directory for SQLite persistence
RUN mkdir -p data

EXPOSE 5000

CMD ["node", "src/server.js"]
